{
	"schemaVersion": 1,
	"id": "jonarchymod",
	"version": "${version}",
	"name": "JonarchyMod",
	"description": "Automatically keeps Jonarchy (jonarchy.com) at the top of your multiplayer server list and unblocks servers blocked by Mojang.",
	"authors": [
		"Jonarchy"
	],
	"contact": {
		"homepage": "https://www.jonarchy.com"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"me.jonarchy.jonarchymod.JonarchyMod"
		]
	},
	"mixins": [
		"jonarchymod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=8"
	}
}